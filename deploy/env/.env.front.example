# /opt/blog/.env.front — production environment for the Next.js container
# Container-internal API address (server-side fetches)
API_INTERNAL_URL=http://api:4201
# Public site + API URLs (canonical links, browser-side search calls)
NEXT_PUBLIC_SITE_URL=https://mikhailbahdashych.me
NEXT_PUBLIC_API_URL=https://api.mikhailbahdashych.me
# Must match the API's REVALIDATE_SECRET
REVALIDATE_SECRET=
