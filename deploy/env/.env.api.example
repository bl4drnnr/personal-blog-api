# /opt/blog/.env.api — production environment for the API container
API_PORT=4201
CORS_ORIGINS=https://mikhailbahdashych.me,https://admin.mikhailbahdashych.me
# Swagger UI at /api/docs. Set to 'false' to hide the API surface in production.
SWAGGER_ENABLED=true

# RDS. TLS is verified against the AWS RDS CA bundle baked into the image.
DATABASE_URL=postgres://USER:PASSWORD@YOUR-RDS-HOST.eu-central-1.rds.amazonaws.com:5432/personal_blog
DATABASE_SSL=true

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Real S3 (no S3_ENDPOINT in production)
S3_REGION=eu-central-1
S3_BUCKET=bahdashych-on-security
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://bahdashych-on-security.s3.eu-central-1.amazonaws.com

# Container-internal address of the Next.js frontend
FRONT_INTERNAL_URL=http://front:3000
# Must match the frontend's REVALIDATE_SECRET. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
